{
	"name": "web",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun run .output/server/index.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"test": "bun --bun vitest",
		"test:run": "bun --bun vitest run",
		"test:smoke": "bun run build && bun run scripts/smoke-production.ts",
		"typecheck": "bun run build && tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.7",
		"better-auth": "^1.7.29",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.83.0",
		"nitro": "^3.0.1-alpha.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shadcn": "^4.23.1",
		"tailwind-merge": "^3.7.1",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/browser-playwright": "^5.1.2",
		"better-sqlite3": "^13.2.0",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.1.2",
		"vitest-browser-react": "^2.3.0"
	}
